# Copy to .env.local (local) or set in your Vercel / Netlify project settings.
# OPTIONAL — the site works without any environment variables.

# Public production URL, used for canonical + Open Graph links.
# On Vercel this falls back to the project's production domain automatically.
NEXT_PUBLIC_SITE_URL=https://your-wedding-site.example
# NEXT_PUBLIC_* values are visible to visitors — never put a secret key here.
