# Copy to .env.local (local) or set in your Netlify / Vercel project settings.

# REQUIRED for personalised invite links and the admin page.
# A long random value, e.g. from:  openssl rand -hex 16
# Set it ONCE before sending any links — changing it changes every link.
# Your admin page is then:  https://<your-site>/admin/<INVITE_SECRET>
INVITE_SECRET=

# Optional: public site URL for link previews (a custom domain).
# Netlify and Vercel builds use their own address automatically.
# NEXT_PUBLIC_* values are visible to visitors — never put a secret key here.
# NEXT_PUBLIC_SITE_URL=https://your-wedding-site.example
